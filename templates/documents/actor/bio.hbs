<section class="tab bio {{tabs.bio.cssClass}}" data-group="primary" data-tab="bio">
  <div class="vstack gap-md p-md">
    <input name="name" type="text" value="{{document.name}}" class="actor-name">
    <div class="virtue-grid">
      {{#each virtues}}
      <div class="virtue-label">{{localize label}}</div>
      {{formGroup
      fields.value
      value=values.value
      rootId=../sysId
      label=(concat values.value "/" values.max)
      classes=classname
      }}
      <i class="fa-solid fa-ellipsis-vertical"></i>
      {{/each}}
    </div>
    <div class="virtue-grid">
      {{#each vitals}}
      <div class="virtue-label">{{localize label}}</div>
      {{formGroup
      fields.value
      value=values.value
      rootId=../sysId
      label=(concat values.value "/" values.max)
      classes=classname
      }}
      <i class="fa-solid fa-ellipsis-vertical"></i>
      {{/each}}
    </div>
  </div>
</section>