<section class="tab bio {{tabs.bio.cssClass}} {{ifThen inUse "" " edit"}}" data-group="primary" data-tab="bio">
  <div class="form-field">
    <button type="button" class="icon-button toggle-button {{ifThen inUse "" " active"}}" id="toggle-edit"
      style="position:absolute; top:1rem; left:1rem">
      <i class="fa-solid fa-wrench"></i>
    </button>
  </div>
  <div class="vstack gap-md p-md">
    <input name="name" type="text" value="{{document.name}}" class="actor-name">
    <div class="virtue-grid">
      {{#each virtues}}
      <div class="virtue-label">{{localize label}}</div>
      <div class="virtue-meter {{key}}">
        {{formGroup
        fields.value
        value=values.value
        rootId=../sysId
        label=(concat values.value "/" values.max)
        classes="virtue-input-value"
        }}
        <label for="{{../sysId}}-system.resources.virtues.{{key}}.maxBase" class="virtue-max-label">
          Max:
        </label>
        {{formGroup
        fields.maxBase
        rootId=../sysId
        value=values.maxBase
        label=(concat "(" (numberFormat values.maxBonus sign=true) ")")
        classes="virtue-input-max"
        }}
      </div>
      {{/each}}
    </div>
    <div class="virtue-grid">
      {{#each vitals}}
      <div class="virtue-label">{{localize label}}</div>
      <div class="virtue-meter {{key}}">
        {{formGroup
        fields.value
        value=values.value
        rootId=../sysId
        label=(concat values.value "/" values.max)
        classes="virtue-input-value"
        }}
        <label for="{{../sysId}}-system.resources.vitals.{{key}}.maxBase" class="virtue-max-label">
          Max:
        </label>
        {{formGroup
        fields.maxBase
        rootId=../sysId
        value=values.maxBase
        label=(concat "(" (numberFormat values.maxBonus sign=true) ")")
        classes="virtue-input-max"
        }}
      </div>
      {{/each}}
    </div>
  </div>
</section>