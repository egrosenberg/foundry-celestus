<section class="tab attributes {{tabs.attributes.cssClass}} {{ifThen inUse "" " edit"}}" data-group="primary"
  data-tab="attributes">
  <button type="button" class="icon-button toggle-button {{ifThen inUse "" " active"}}" id="toggle-edit"
    style="position:sticky; top:0; left:1rem; margin-top: -2rem; display: none;">
    <i class="fa-solid fa-wrench"></i>
  </button>
  <div class="vstack gap-xl align-stretch p-lg">
    <div class="vstack gap-md">
      <div class="vstack gap-xs px-sm">
        <h4>Description</h4>
        <prose-mirror name="system.description" value="{{system.description}}" collaborate="true"
          data-document-uuid="{{document.uuid}}" toggled>
          {{{ system.description }}}
        </prose-mirror>
      </div>
      {{!-- Normal details for holdable items --}}
      <h5>Details</h5>
      <div class="hstack gap-md align-center">
        <div class="form-group hstack gap-sm align-center">
          <label for="system.hands">Hands</label>
          <select name="system.hands">
            <option value="1" {{ifThen (eq system.hands 1) "selected" }}>One handed</option>
            <option value="2" {{ifThen (eq system.hands 2) "selected" }}>Two handed</option>
          </select>
        </div>
        {{formGroup
        systemFields.isWeapon
        rootId=sysId
        value=system.isWeapon
        classes="hstack gap-xs align-center"
        label="Is weapon"
        }}
        {{#if system.isWeapon}}
        {{formGroup
        systemFields.tags.fields.canOffhand
        rootId=sysId
        value=system.tags.canOffhand
        classes="hstack gap-xs align-center"
        label="Can offhand"
        }}
        {{/if}}
      </div>
      {{!-- Damage section --}}
      {{#if system.isWeapon}}
      <div class="vstack gap-md align-stretch">
        {{!-- Primary damage --}}
        <div class="vstack gap-sm align-stretch">
          <div class="hstack justify-space-between">
            <h6>Primary damage</h6>
            <button class="icon-button ghost small add-index" type="button" data-name="system.damageParts.primary"
              data-default-value='{"types":["physical"], "formula":"d6"}'>
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
          {{#each system.damageParts.primary}}
          <div class="vstack gap-sm w-full">
            <div class="hstack gap-md align-stretch">
              <div class="hstack gap-sm w-full">
                <label for="system.damageParts.primary.{{@index}}.formula">Formula</label>
                <input name="system.damageParts.primary.{{@index}}.formula" value="{{formula}}" class="flex-1">
              </div>
              <button class="icon-button ghost small destructive remove-index" type="button" data-confirm="false"
                data-name="system.damageParts.primary" data-index="{{@index}}">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
            <div class="hstack gap-sm align-center">
              <label for="system.damageParts.primary.{{@index}}.types">Type</label>
              {{#with @index}}
              {{#each ../types}}
              <div class="hstack gap-xs">
                <tag class="hstack gap-xs">
                  <select name="system.damageParts.primary.{{../.}}.types.{{@index}}" class="flex-1">
                    {{selectOptions ../../../config.damageTypes selected=. labelAttr="label" localize=true}}
                  </select>
                  <button class="icon-button  small ghost destructive remove-index" type="button" data-confirm="false"
                    data-name="system.damageParts.primary.{{../.}}.types" data-index="{{@index}}">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </tag>
              </div>
              {{/each}}
              {{/with}}
              <button class="icon-button ghost small add-index" type="button"
                data-name="system.damageParts.primary.{{@index}}.types" data-default-value='"physical"'>
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </div>
          {{/each}}
        </div>
        {{!-- Secondary damage --}}
        <div class="vstack gap-sm align-stretch">
          <div class="hstack justify-space-between">
            <h6>Secondary damage</h6>
            <button class="icon-button ghost small add-index" type="button" data-name="system.damageParts.secondary"
              data-default-value='{"types":["physical"], "formula":"d6"}'>
              <i class="fa-solid fa-plus"></i>
            </button>
          </div>
          {{#each system.damageParts.secondary}}
          <div class="vstack gap-sm w-full">
            <div class="hstack gap-md align-stretch">
              <div class="hstack gap-sm w-full">
                <label for="system.damageParts.secondary.{{@index}}.formula">Formula</label>
                <input name="system.damageParts.secondary.{{@index}}.formula" value="{{formula}}" class="flex-1">
              </div>
              <button class="icon-button small destructive remove-index" type="button" data-confirm="false"
                data-name="system.damageParts.secondary" data-index="{{@index}}">
                <i class="fa-solid fa-trash-can"></i>
              </button>
            </div>
            <div class="hstack gap-sm align-center">
              <label for="system.damageParts.secondary.{{@index}}.types">Type</label>
              {{#with @index}}
              {{#each ../types}}
              <div class="hstack gap-xs">
                <tag class="hstack gap-xs">
                  <select name="system.damageParts.secondary.{{../.}}.types.{{@index}}" class="flex-1">
                    {{selectOptions ../../../config.damageTypes selected=. labelAttr="label" localize=true}}
                  </select>
                  <button class="icon-button small ghost destructive remove-index" type="button" data-confirm="false"
                    data-name="system.damageParts.secondary.{{../.}}.types" data-index="{{@index}}">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                </tag>
              </div>
              {{/each}}
              {{/with}}
              <button class="icon-button small add-index" type="button"
                data-name="system.damageParts.secondary.{{@index}}.types" data-default-value='"physical"'>
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
      <h6>Vitals</h6>
      <div class="hstack gap-md">
        {{
        formGroup
        systemFields.hp
        rootId=../sysId
        value=system.hp
        classes="flex1"
        label=(localize "CELESTUS.VitalHealth")
        }}
        {{
        formGroup
        systemFields.gd
        rootId=../sysId
        value=system.gd
        classes="flex1"
        label=(localize "CELESTUS.VitalGuard")
        }}
        {{
        formGroup
        systemFields.wd
        rootId=../sysId
        value=system.wd
        classes="flex1"
        label=(localize "CELESTUS.VitalWard")
        }}
      </div>
    </div>
    <details>
      <summary>
        Damage modifiers
      </summary>
      <div class="hstack gap-lg">
        {{!-- Damage Resists --}}
        <div class="vstack gap-md">
          <h5>Damage resists</h5>
          {{#each damageResist}}
          <div class="hstack gap-md">
            {{formGroup
            fields.flat
            rootId=../sysId
            value=values.flat
            label=labels.flat
            }}{{formGroup
            fields.percent
            rootId=../sysId
            value=values.percent
            label=labels.percent
            }}
          </div>
          {{/each}}
        </div>
        {{!-- Damage Bonuses --}}
        <div class="vstack gap-md">
          <h5>Damage bonuses</h5>
          {{#each damageBonus}}
          <div class="hstack gap-md">
            {{formGroup
            fields.flat
            rootId=../sysId
            value=values.flat
            label=labels.flat
            }}{{formGroup
            fields.percent
            rootId=../sysId
            value=values.percent
            label=labels.percent
            }}
          </div>
          {{/each}}
        </div>
      </div>
    </details>
    {{!-- You can always... options --}}
    <div class="vstack gap-sm align-stretch">
      <div class="hstack justify-space-between">
        <h4>You can always...</h4>
        <button class="icon-button small add-index" type="button" data-name="system.canAlways" data-default-value='""'>
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      {{#each system.canAlways}}
      <div class="hstack gap-md align-stretch">
        <input name="system.canAlways.{{@index}}" value="{{.}}" class="flex-1">
        <button class="icon-button small destructive remove-index" type="button" data-name="system.canAlways"
          data-noun='"You can always..." option' data-index="{{@index}}">
          <i class="fa-solid fa-trash-can"></i>
        </button>
      </div>
      {{/each}}
    </div>
    {{!-- Misc. abilities --}}
    <div class="vstack gap-sm align-stretch">
      <div class="hstack justify-space-between">
        <h4>Misc. abilities</h4>
        <button class="icon-button small add-index" type="button" data-name="system.abilities" data-default-value='""'>
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
      {{#each system.abilities}}
      <div class="hstack gap-md align-stretch">
        <input name="system.abilities.{{@index}}" value="{{.}}" class="flex-1">
        <button class="icon-button small destructive remove-index" type="button" data-name="system.abilities"
          data-noun="ability" data-index="{{@index}}">
          <i class="fa-solid fa-trash-can"></i>
        </button>
      </div>
      {{/each}}
    </div>

  </div>
</section>