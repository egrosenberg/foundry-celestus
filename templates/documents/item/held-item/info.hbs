<section class="tab info {{tabs.info.cssClass}} {{ifThen inUse "" " edit"}}" data-group="primary" data-tab="info">
  <div class="vstack gap-md p-md">
    <input name="name" type="text" value="{{document.name}}" class="actor-name text-align-center">
    {{!-- {{
    formGroup
    systemFields.description
    rootId=../sysId
    value=system.description
    }} --}}
    <div class="hstack justify-center flex-wrap-wrap gap-sm">
      {{#if (and system.isWeapon system.damageParts.primary.length)}}
      <tag>
        {{#each system.damageParts.primary}}
        {{#with @index}} {{ifThen (eq . 0) "" " + "}} {{/with}}
        {{formula}} {{types.[0]}}
        {{/each}}
      </tag>
      {{/if}}
      {{> "systems/celestus-2/templates/documents/item/partials/info/vitals-tags.hbs"}}
      {{> "systems/celestus-2/templates/documents/item/partials/info/damage-resist-tags.hbs"}}
    </div>
    {{#if (or system.description.length system.canAlways.length)}}
    <hr>
    {{/if}}
    <div class="vstack gap-xs px-sm">
      {{{ system.description }}}
      {{#if system.canAlways.length}}
      <div>
        <h6>You can always...</h6>
        <ul>
          {{#each system.canAlways}}
          <li>{{.}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
      {{#each system.abilities}}
      {{.}}
      {{/each}}
    </div>

  </div>
</section>